verilog

// example qucs models. see Gnucsator for more..
`include qucs.v

// load the schematic.
`include helloworld.vs

// instanciate it, connect two nets.
helloworld h(.P1(in), .P2(out));

// set some probes
`print tran v(in) v(out) iter(0)

// simulate 1 second
`tran 1 basic

// print some stats
status notime

// get rid of the ac source
delete helloworld.V1

// is it gone?
list helloworld

// some retro computing (but need case sensitive)
`spice
.options noinsensitive
V1 in 0 pulse iv=0 pv=1 rise=1
.print tran v(in) v(out) iter(0)
.tran 1 basic
.status notime
