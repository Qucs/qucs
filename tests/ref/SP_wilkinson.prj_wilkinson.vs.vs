(* qucs_ViewX1=0, qucs_ViewY1=0, qucs_ViewX2=800, qucs_ViewY2=800, qucs_Scale=1, qucs_tmpViewX1=-200, qucs_tmpViewY1=-200, qucs_GridX=10, qucs_GridY=10, qucs_GridOn=1, qucs_DataSet="wilkinson.dat", qucs_DataDisplay="wilkinson.dpl", qucs_SimOpenDpl=1, qucs_Script="wilkinson.m", qucs_SimRunScript=0, qucs_showFrame=0, qucs_FrameText0="Title", qucs_FrameText1="Drawn By:", qucs_FrameText2="Date:", qucs_FrameText3="Revision:" *) module wilkinson();
    wire n_60_80;
    wire n_60_140;
    wire n_100_80;
    wire n_160_80;
    wire n_200_40;
    wire n_260_40;
    wire n_200_140;
    wire n_260_140;
    wire n_410_40;
    wire n_410_100;
    wire n_410_140;
    wire n_410_200;
    wire n_300_120;
    wire n_300_60;
    wire n_180_40;
    wire n_180_80;
    wire n_180_140;
    wire n_300_40;
    wire n_300_140;
    (* qucs_mirrored=1, qucs_rotated=1, S0_x1=60, S0_y1=80, S0_x2=60, S0_y2=140 *) Pac #(.Num(1),.Z(50 Ohm),.P(0 dBm),.f(1 GHz),.Temp(26.85)) P1 ( n_60_80, n_60_140 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=60, S0_y1=140 *) GND #() \*  ( n_60_140 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=100, S0_y1=80, S0_x2=160, S0_y2=80 *) TLIN #(.Z(50 Ohm),.L(100 mm),.Alpha(0 dB),.Temp(26.85)) Line1 ( n_100_80, n_160_80 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=200, S0_y1=40, S0_x2=260, S0_y2=40 *) TLIN #(.Z(70.7 Ohm),.L(75 mm),.Alpha(0 dB),.Temp(26.85)) Line2 ( n_200_40, n_260_40 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=200, S0_y1=140, S0_x2=260, S0_y2=140 *) TLIN #(.Z(70.7 Ohm),.L(75 mm),.Alpha(0 dB),.Temp(26.85)) Line3 ( n_200_140, n_260_140 );
    (* qucs_mirrored=0, qucs_rotated=1, S0_x1=410, S0_y1=40, S0_x2=410, S0_y2=100 *) Pac #(.Num(2),.Z(50 Ohm),.P(0 dBm),.f(1 GHz),.Temp(26.85)) P2 ( n_410_40, n_410_100 );
    (* qucs_mirrored=0, qucs_rotated=1, S0_x1=410, S0_y1=140, S0_x2=410, S0_y2=200 *) Pac #(.Num(3),.Z(50 Ohm),.P(0 dBm),.f(1 GHz),.Temp(26.85)) P3 ( n_410_140, n_410_200 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=410, S0_y1=200 *) GND #() \*  ( n_410_200 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=410, S0_y1=100 *) GND #() \*  ( n_410_100 );
    (* qucs_mirrored=0, qucs_rotated=1, S0_x1=300, S0_y1=120, S0_x2=300, S0_y2=60 *) R #(.R(100 Ohm),.Temp(26.85),.Tc1(0.0),.Tc2(0.0),.Tnom(26.85)) R1 ( n_300_120, n_300_60 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=-10, S0_y1=210 *) \.SP  #(.Type(lin),.Start(0.1 MHz),.Stop(2 GHz),.Points(100),.Noise(no),.NoiseIP(1),.NoiseOP(2),.saveCVs(no),.saveAll(no)) SP1 (  );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=140, S0_y1=230 *) Eqn #(.y(1),.Export(yes)) Eqn1 (  );
    (* S0_x1=180, S0_y1=40, S0_x2=200, S0_y2=40 *) net #() net1 ( n_180_40, n_200_40 );
    (* S0_x1=180, S0_y1=40, S0_x2=180, S0_y2=80 *) net #() net2 ( n_180_40, n_180_80 );
    (* S0_x1=180, S0_y1=140, S0_x2=200, S0_y2=140 *) net #() net3 ( n_180_140, n_200_140 );
    (* S0_x1=260, S0_y1=40, S0_x2=300, S0_y2=40 *) net #() net4 ( n_260_40, n_300_40 );
    (* S0_x1=260, S0_y1=140, S0_x2=300, S0_y2=140 *) net #() net5 ( n_260_140, n_300_140 );
    (* S0_x1=60, S0_y1=80, S0_x2=100, S0_y2=80 *) net #() net6 ( n_60_80, n_100_80 );
    (* S0_x1=180, S0_y1=80, S0_x2=180, S0_y2=140 *) net #() net7 ( n_180_80, n_180_140 );
    (* S0_x1=160, S0_y1=80, S0_x2=180, S0_y2=80 *) net #() net8 ( n_160_80, n_180_80 );
    (* S0_x1=300, S0_y1=140, S0_x2=410, S0_y2=140 *) net #() net9 ( n_300_140, n_410_140 );
    (* S0_x1=300, S0_y1=120, S0_x2=300, S0_y2=140 *) net #() net10 ( n_300_120, n_300_140 );
    (* S0_x1=300, S0_y1=40, S0_x2=410, S0_y2=40 *) net #() net11 ( n_300_40, n_410_40 );
    (* S0_x1=300, S0_y1=40, S0_x2=300, S0_y2=60 *) net #() net12 ( n_300_40, n_300_60 );
    (* S0_x=270, S0_y=240, qucs_type="Text", S0_text="ideal Wilkinson divider:\n- power into port 1 is split equally to port 2 and 3\n- port 2 and 3 are decoupled\n- if port 2 and 3 are terminated equally, no power\n  is consumed by R1\n- a wider bandwidth can be achieved by using\n  more than one Line2/Line3/R1 section", qucs_font_color="#000000", qucs_font_size=12, qucs_font_angle=0 *) S__text #() S0_text1();
endmodule
