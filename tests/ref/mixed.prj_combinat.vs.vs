    (* qucs_mirrored=0, qucs_rotated=1, S0_x1=120, S0_y1=180, S0_x2=120, S0_y2=240 *) Vrect #(.U(1),.TH(20 ns),.TL(20 ns),.Tr(1 ns),.Tf(1 ns),.Td(0)) V1 ( n_120_180, n_120_240 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=120, S0_y1=260 *) GND #() \\*  ( n_120_260 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=330, S0_y1=70, S0_x2=350, S0_y2=70 *) VProbe #() Pr1 ( n_330_70, n_350_70 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=350, S0_y1=70 *) GND #() \\*6  ( n_350_70 );
    (* qucs_mirrored=0, qucs_rotated=0, S0_x1=130, S0_y1=450 *) GND #() \\*  ( n_130_450 );
    (* qucs_mirrored=0, qucs_rotated=1, S0_x1=130, S0_y1=390, S0_x2=130, S0_y2=450 *) Vrect #(.U(1),.TH(10 ns),.TL(10 ns),.Tr(1 ns),.Tf(1 ns),.Td(10ns)) V2 ( n_130_390, n_130_450 );
