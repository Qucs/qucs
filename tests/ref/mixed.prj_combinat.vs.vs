    wire n_910_130;
    (* S0_x1=370, S0_y1=350, S0_x2=390, S0_y2=350, qucs_mirroredX=0, qucs_rotated=0 *) VProbe #() Pr3 ( n_370_350, n_390_350 );
    (* S0_x1=400, S0_y1=330, qucs_mirroredX=0, qucs_rotated=0 *) GND #() \\*  ( n_400_330 );
    (* S0_x1=880, S0_y1=150, S0_x2=900, S0_y2=150, qucs_mirroredX=0, qucs_rotated=0 *) VProbe #() Pr5 ( n_880_150, n_900_150 );
    (* S0_x1=620, S0_y1=220, S0_x2=620, S0_y2=280, qucs_mirroredX=0, qucs_rotated=1 *) Vdc #(.U(1 V)) V3 ( n_620_220, n_620_280 );
    (* S0_x1=730, S0_y1=310, qucs_mirroredX=0, qucs_rotated=0 *) GND #() \\*  ( n_730_310 );
    (* S0_x1=620, S0_y1=310, qucs_mirroredX=0, qucs_rotated=0 *) GND #() \\*5  ( n_620_310 );
    (* S0_x1=910, S0_y1=130, qucs_mirroredX=0, qucs_rotated=0 *) GND #() \\*4  ( n_910_130 );
    (* S0_x1=710, S0_y1=80, S0_x2=710, S0_y2=100, S0_x3=710, S0_y3=120, S0_x4=710, S0_y4=150, S0_x5=710, S0_y5=170, S0_x6=710, S0_y6=190, S0_x7=710, S0_y7=210, S0_x8=810, S0_y8=130, qucs_mirroredX=0, qucs_rotated=0 *) mux4to1 #(.TR(6),.Delay(1)) Y5 ( n_710_80, n_710_100, n_710_120, n_710_150, n_710_170, n_710_190, n_710_210, n_810_130 );
    (* S0_x1=120, S0_y1=150, S0_x2=120, S0_y2=210, qucs_mirroredX=0, qucs_rotated=1 *) Vrect #(.U(1),.TH(20 ns),.TL(20 ns),.Tr(1 ns),.Tf(1 ns),.Td(0)) V1 ( n_120_150, n_120_210 );
    (* S0_x1=120, S0_y1=260, qucs_mirroredX=0, qucs_rotated=0 *) GND #() \\*  ( n_120_260 );
    (* S0_x1=320, S0_y1=90, S0_x2=340, S0_y2=90, qucs_mirroredX=0, qucs_rotated=0 *) VProbe #() Pr1 ( n_320_90, n_340_90 );
    (* S0_x1=350, S0_y1=70, qucs_mirroredX=0, qucs_rotated=0 *) GND #() \\*6  ( n_350_70 );
    (* S0_x1=130, S0_y1=450, qucs_mirroredX=0, qucs_rotated=0 *) GND #() \\*  ( n_130_450 );
    (* S0_x1=130, S0_y1=360, S0_x2=130, S0_y2=420, qucs_mirroredX=0, qucs_rotated=1 *) Vrect #(.U(1),.TH(10 ns),.TL(10 ns),.Tr(1 ns),.Tf(1 ns),.Td(10ns)) V2 ( n_130_360, n_130_420 );
